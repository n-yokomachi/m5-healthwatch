# Copy to .env (git-ignored) and fill in. Read at build time by firmware/
# (the settings are compiled into the StopWatch program).

# The Wi-Fi the StopWatch joins.
WIFI_SSID=
WIFI_PASS=

# HealthWatch agent (agent/): the Cognito app client, the user and the AgentCore Runtime ARN.
HW_USER_POOL_CLIENT_ID=
HW_USERNAME=
HW_PASSWORD=
HW_RUNTIME_ARN=
